<!doctype html>
<html lang="en"><head><%- include("partials/head") %><title>Sign in — Clearline</title></head>
<body>
<div class="top"><b>Clearline</b><span class="ws">Contract workspace</span></div>
<main style="max-width:24rem">
  <h1>Sign in</h1>
  <% if (error) { %><div class="err"><%= error %></div><% } %>
  <form method="post" action="/login">
    <p><label>Email<br><input type="email" name="email" autocomplete="username" required></label></p>
    <p><label>Password<br><input type="password" name="password" autocomplete="current-password" required></label></p>
    <button type="submit">Sign in</button>
  </form>
</main>
</body></html>
