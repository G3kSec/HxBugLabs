<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>
  :root { --line:#e2e5ea; --muted:#6b7280; --ink:#111827; --accent:#1d4ed8; }
  * { box-sizing: border-box; }
  body { font: 15px/1.55 -apple-system, "Segoe UI", Roboto, sans-serif; margin:0; color:var(--ink); background:#f7f8fa; }
  a { color: var(--accent); }
  .top { background:#fff; border-bottom:1px solid var(--line); padding:.9rem 1.5rem; display:flex; align-items:center; gap:1rem; }
  .top b { letter-spacing:-.02em; }
  .top .ws { color:var(--muted); font-size:.85rem; border-left:1px solid var(--line); padding-left:1rem; }
  .top .spacer { margin-left:auto; }
  main { max-width:56rem; margin:2rem auto; padding:0 1.5rem; }
  h1 { font-size:1.35rem; letter-spacing:-.02em; margin:0 0 1.25rem; }
  .card { background:#fff; border:1px solid var(--line); border-radius:8px; padding:1rem 1.25rem; margin-bottom:.75rem; }
  .card h3 { margin:0 0 .3rem; font-size:1rem; }
  .meta { color:var(--muted); font-size:.85rem; }
  .pill { display:inline-block; font-size:.72rem; text-transform:uppercase; letter-spacing:.04em; padding:.15rem .5rem; border-radius:999px; background:#eef2ff; color:#3730a3; }
  input, button { font: inherit; }
  input[type=text], input[type=email], input[type=password] { width:100%; padding:.6rem .75rem; border:1px solid #c7cdd6; border-radius:6px; }
  button { padding:.6rem 1rem; border:0; border-radius:6px; background:var(--accent); color:#fff; cursor:pointer; }
  .err { background:#fef2f2; border:1px solid #fecaca; color:#991b1b; padding:.6rem .75rem; border-radius:6px; margin-bottom:1rem; font-size:.9rem; }
  pre { background:#f3f4f6; padding:.9rem; border-radius:6px; overflow:auto; font-size:.85rem; }
</style>
