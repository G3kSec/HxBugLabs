<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
  <header>
    <span class="brand">Acme HelpDesk</span>
    <nav>
      <span class="muted" style="color:#b7c4dd;">Signed in as <%= user.displayName %></span>
      <a href="/logout">Log out</a>
    </nav>
  </header>
  <main>
    <div class="card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
        <h1 style="margin:0;">My tickets</h1>
        <a class="btn" href="/tickets/new">New ticket</a>
      </div>
      <table>
        <thead>
          <tr><th>#</th><th>Subject</th><th>Status</th></tr>
        </thead>
        <tbody>
          <% tickets.forEach(t => { %>
          <tr>
            <td>#<%= t.id %></td>
            <td><a class="ticket-link" href="/tickets/<%= t.id %>"><%= t.subject %></a></td>
            <td><span class="status <%= t.status %>"><%= t.status %></span></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
