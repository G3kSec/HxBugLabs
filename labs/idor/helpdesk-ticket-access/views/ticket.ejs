<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
  <header>
    <span class="brand">Acme HelpDesk</span>
    <nav>
      <a href="/dashboard">My tickets</a>
      <a href="/logout">Log out</a>
    </nav>
  </header>
  <main>
    <div class="card">
      <h1>Ticket #<%= ticket.id %> — <%= ticket.subject %></h1>
      <p class="muted">Status: <span class="status <%= ticket.status %>"><%= ticket.status %></span></p>
      <pre class="body"><%= ticket.body %></pre>
    </div>
  </main>
</body>
</html>
