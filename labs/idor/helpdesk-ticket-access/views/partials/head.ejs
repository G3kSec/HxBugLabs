<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Acme HelpDesk</title>
<style>
  * { box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: #f4f6f8; color: #1a1f26; margin: 0;
  }
  header {
    background: #16233b; color: #fff; padding: 0.9rem 1.5rem;
    display: flex; align-items: center; justify-content: space-between;
  }
  header .brand { font-weight: 700; letter-spacing: 0.02em; }
  header nav a { color: #b7c4dd; text-decoration: none; margin-left: 1.2rem; font-size: 0.9rem; }
  header nav a:hover { color: #fff; }
  main { max-width: 760px; margin: 2rem auto; padding: 0 1.5rem; }
  .card { background: #fff; border: 1px solid #dfe4ea; border-radius: 8px; padding: 1.5rem; margin-bottom: 1rem; }
  h1 { font-size: 1.4rem; margin: 0 0 0.5rem; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 0.6rem 0.5rem; border-bottom: 1px solid #eceff2; font-size: 0.9rem; }
  th { color: #6b7684; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; }
  tr:hover td { background: #f8f9fb; }
  a.ticket-link { color: #2455c9; text-decoration: none; font-weight: 500; }
  a.ticket-link:hover { text-decoration: underline; }
  .status { display: inline-block; padding: 0.15rem 0.55rem; border-radius: 999px; font-size: 0.72rem; font-weight: 600; }
  .status.open { background: #fff2d9; color: #96690a; }
  .status.answered { background: #ddf3e4; color: #17803c; }
  .btn {
    display: inline-block; background: #2455c9; color: #fff; border: none;
    padding: 0.55rem 1.1rem; border-radius: 6px; font-size: 0.88rem; font-weight: 600;
    text-decoration: none; cursor: pointer;
  }
  .btn:hover { background: #1e46ad; }
  label { display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem; }
  input, textarea {
    width: 100%; padding: 0.55rem 0.7rem; border: 1px solid #d3dae3; border-radius: 6px;
    font-size: 0.9rem; margin-bottom: 1rem; font-family: inherit;
  }
  textarea { min-height: 100px; resize: vertical; }
  .error { background: #fdeaea; color: #a4222c; padding: 0.7rem 1rem; border-radius: 6px; margin-bottom: 1rem; font-size: 0.88rem; }
  .muted { color: #6b7684; font-size: 0.85rem; }
  pre.body { white-space: pre-wrap; font-family: inherit; font-size: 0.92rem; line-height: 1.55; }
</style>
