<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>LinkPreview</title>
<style>
  * { box-sizing: border-box; }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #f3f8f7; color: #10201c; margin: 0; }
  header { background: #0b3d33; color: #fff; padding: 0.9rem 1.5rem; display: flex; align-items: center; justify-content: space-between; }
  header .brand { font-weight: 700; }
  header nav a { color: #a9d9cc; text-decoration: none; margin-left: 1.1rem; font-size: 0.9rem; }
  header nav a:hover { color: #fff; }
  main { max-width: 700px; margin: 2rem auto; padding: 0 1.5rem; }
  .card { background: #fff; border: 1px solid #dcece7; border-radius: 8px; padding: 1.5rem; margin-bottom: 1rem; }
  h1 { font-size: 1.35rem; margin: 0 0 0.5rem; }
  label { display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem; }
  input { width: 100%; padding: 0.55rem 0.7rem; border: 1px solid #cfe3dc; border-radius: 6px; font-size: 0.9rem; margin-bottom: 1rem; font-family: inherit; }
  .btn { display: inline-block; background: #0f7a5f; color: #fff; border: none; padding: 0.55rem 1.1rem; border-radius: 6px; font-size: 0.88rem; font-weight: 600; text-decoration: none; cursor: pointer; }
  .btn:hover { background: #0c6249; }
  .error { background: #fdeaea; color: #a4222c; padding: 0.7rem 1rem; border-radius: 6px; margin-bottom: 1rem; font-size: 0.88rem; }
  .muted { color: #5c6f68; font-size: 0.85rem; }
  pre.result { white-space: pre-wrap; font-family: ui-monospace, monospace; font-size: 0.85rem; line-height: 1.5; background: #f0f6f4; padding: 1rem; border-radius: 6px; overflow-x: auto; }
  ul.svc-list li { font-family: ui-monospace, monospace; font-size: 0.85rem; padding: 0.25rem 0; }
</style>
