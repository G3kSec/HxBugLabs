<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
  <header>
    <span class="brand">LinkPreview</span>
    <nav><a href="/status">System status</a><a href="/logout">Log out</a></nav>
  </header>
  <main>
    <div class="card">
      <h1>Preview a link</h1>
      <p class="muted">Paste a URL and we'll fetch a snippet of it — handy before sharing a link with your team.</p>
      <% if (error) { %><div class="error"><%= error %></div><% } %>
      <form method="POST" action="/preview">
        <label for="url">URL</label>
        <input id="url" name="url" value="<%= url %>" placeholder="https://example.com" required>
        <button class="btn" type="submit">Preview</button>
      </form>
    </div>
    <% if (result) { %>
    <div class="card">
      <h2 style="font-size:1rem; margin:0 0 0.5rem;">Preview</h2>
      <pre class="result"><%= result %></pre>
    </div>
    <% } %>
  </main>
</body>
</html>
