<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>
  :root { --line:#e6e1da; --muted:#6f675e; --ink:#241f1a; --accent:#8a4b2a; }
  * { box-sizing:border-box; }
  body { font:15px/1.6 Georgia, "Iowan Old Style", serif; margin:0; color:var(--ink); background:#fbf8f4; }
  a { color:var(--accent); }
  .top { background:#fff; border-bottom:1px solid var(--line); padding:.9rem 1.5rem; display:flex; gap:1.25rem; align-items:baseline; }
  .top b { font-family:-apple-system,"Segoe UI",sans-serif; letter-spacing:-.01em; }
  .top a { font:14px -apple-system,"Segoe UI",sans-serif; text-decoration:none; }
  .top .spacer { margin-left:auto; }
  main { max-width:50rem; margin:2rem auto; padding:0 1.5rem; }
  h1 { font-size:1.4rem; margin:0 0 1rem; }
  .panel { background:#fff; border:1px solid var(--line); border-radius:4px; padding:1.1rem 1.3rem; margin-bottom:1rem; }
  .muted { color:var(--muted); font-size:.87rem; }
  label { display:block; font:13px/1.5 -apple-system,"Segoe UI",sans-serif; color:var(--muted); margin-bottom:.2rem; }
  input { font:14px ui-monospace, Menlo, monospace; width:100%; padding:.55rem .7rem; border:1px solid #d5cec5; border-radius:3px; background:#fdfcfa; }
  button { font:14px -apple-system,"Segoe UI",sans-serif; padding:.55rem 1.1rem; border:0; border-radius:3px; background:var(--accent); color:#fff; cursor:pointer; }
  .err { background:#fdf0ee; border:1px solid #eccbc3; color:#8a2c14; padding:.55rem .7rem; border-radius:3px; margin-bottom:.9rem; font-size:.9rem; }
  .ok { background:#f0f6ee; border:1px solid #cfe0c8; color:#31572a; padding:.55rem .7rem; border-radius:3px; margin-bottom:.9rem; font-size:.9rem; }
  pre { background:#f5f2ed; border:1px solid var(--line); padding:.75rem; border-radius:3px; overflow:auto; font:12px/1.5 ui-monospace, Menlo, monospace; white-space:pre-wrap; word-break:break-all; }
  .row { display:flex; gap:.75rem; }
  .row > div { flex:1; }
</style>
