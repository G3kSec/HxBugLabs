<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>NoteShare</title>
<style>
  * { box-sizing: border-box; }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #f7f5ff; color: #201c33; margin: 0; }
  header { background: #2c1f4a; color: #fff; padding: 0.9rem 1.5rem; display: flex; align-items: center; justify-content: space-between; }
  header .brand { font-weight: 700; }
  header nav a { color: #c9bdec; text-decoration: none; margin-left: 1.1rem; font-size: 0.9rem; }
  header nav a:hover { color: #fff; }
  main { max-width: 720px; margin: 2rem auto; padding: 0 1.5rem; }
  .card { background: #fff; border: 1px solid #e3ddf5; border-radius: 8px; padding: 1.5rem; margin-bottom: 1rem; }
  h1 { font-size: 1.35rem; margin: 0 0 0.5rem; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 0.6rem 0.5rem; border-bottom: 1px solid #ece7fb; font-size: 0.9rem; }
  th { color: #6b6482; font-size: 0.75rem; text-transform: uppercase; }
  a.note-link { color: #6935d3; text-decoration: none; font-weight: 500; }
  a.note-link:hover { text-decoration: underline; }
  .btn { display: inline-block; background: #6935d3; color: #fff; border: none; padding: 0.55rem 1.1rem; border-radius: 6px; font-size: 0.88rem; font-weight: 600; text-decoration: none; cursor: pointer; }
  .btn:hover { background: #5828b0; }
  label { display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem; }
  input, textarea { width: 100%; padding: 0.55rem 0.7rem; border: 1px solid #d9d2f0; border-radius: 6px; font-size: 0.9rem; margin-bottom: 1rem; font-family: inherit; }
  textarea { min-height: 110px; resize: vertical; }
  .error { background: #fdeaea; color: #a4222c; padding: 0.7rem 1rem; border-radius: 6px; margin-bottom: 1rem; font-size: 0.88rem; }
  .success { background: #e7f8ee; color: #17803c; padding: 0.7rem 1rem; border-radius: 6px; margin-bottom: 1rem; font-size: 0.88rem; }
  .muted { color: #6b6482; font-size: 0.85rem; }
  .flag { font-family: ui-monospace, monospace; background: #201c33; color: #7ef2b0; padding: 0.6rem 0.9rem; border-radius: 6px; display: inline-block; margin-top: 0.5rem; }
  pre.body { white-space: pre-wrap; font-family: inherit; font-size: 0.92rem; line-height: 1.55; }
  code.cap { font-family: ui-monospace, monospace; font-size: 0.78rem; background: #f2effc; padding: 0.5rem; border-radius: 4px; display: block; word-break: break-all; }
</style>
