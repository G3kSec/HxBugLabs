<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
  <header>
    <span class="brand">NoteShare</span>
    <nav>
      <a href="/search">Search</a>
      <a href="/report">Report a link</a>
      <a href="/logout">Log out</a>
    </nav>
  </header>
  <main>
    <% if (solvedReflected) { %>
      <div class="card">
        <p class="success" style="margin:0;">Objective 1 solved.</p>
      </div>
    <% } %>
    <div class="card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
        <h1 style="margin:0;">My notes</h1>
        <a class="btn" href="/notes/new">New note</a>
      </div>
      <table>
        <thead><tr><th>#</th><th>Title</th></tr></thead>
        <tbody>
          <% notes.forEach(n => { %>
          <tr><td>#<%= n.id %></td><td><a class="note-link" href="/notes/<%= n.id %>"><%= n.title %></a></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
