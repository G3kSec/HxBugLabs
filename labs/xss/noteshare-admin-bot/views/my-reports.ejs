<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
  <header>
    <span class="brand">NoteShare</span>
    <nav><a href="/notes">My notes</a><a href="/report">Report a link</a><a href="/logout">Log out</a></nav>
  </header>
  <main>
    <div class="card">
      <h1>Captured traffic</h1>
      <p class="muted">Anything your reported pages sent to /api/collect shows up here.</p>
      <% if (captures.length === 0) { %>
        <p class="muted">Nothing captured yet.</p>
      <% } %>
      <% captures.forEach(c => { %>
        <div style="padding: 0.7rem 0; border-bottom: 1px solid #ece7fb;">
          <p class="muted" style="margin: 0 0 0.3rem;"><%= c.capturedAt %></p>
          <code class="cap"><%= c.cookie %></code>
        </div>
      <% }) %>
    </div>
  </main>
</body>
</html>
