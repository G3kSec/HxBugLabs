<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
  <header>
    <span class="brand">NoteShare</span>
    <nav><a href="/notes">My notes</a><a href="/my-reports">My reports</a><a href="/logout">Log out</a></nav>
  </header>
  <main>
    <div class="card">
      <h1>Report a link to support</h1>
      <p class="muted">Found something broken? Paste the link and our support team will take a look.</p>
      <% if (error) { %><div class="error"><%= error %></div><% } %>
      <% if (result) { %><div class="success"><%= result %></div><% } %>
      <form method="POST" action="/report">
        <label for="url">URL</label>
        <input id="url" name="url" placeholder="http://localhost:8081/notes/2" required>
        <button class="btn" type="submit">Submit report</button>
      </form>
    </div>
  </main>
</body>
</html>
