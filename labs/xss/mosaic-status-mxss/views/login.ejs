<!doctype html>
<html lang="en"><head><%- include("partials/head") %><title>Sign in — Mosaic Status</title></head>
<body>
<div class="top"><b>Mosaic Status</b><span class="spacer"></span><a href="/">Status</a></div>
<main style="max-width:22rem">
  <h1>Sign in</h1>
  <% if (error) { %><div class="err"><%= error %></div><% } %>
  <form method="post" action="/login">
    <p><label class="muted">Username</label><input id="username" name="username" autocomplete="username" required></p>
    <p><label class="muted">Password</label><input id="password" type="password" name="password" autocomplete="current-password" required></p>
    <button type="submit">Sign in</button>
  </form>
</main>
</body></html>
