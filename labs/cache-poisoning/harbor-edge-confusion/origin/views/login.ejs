<!doctype html>
<html lang="en"><head><%- include("partials/head") %><title>Sign in — Harbor</title></head>
<body>
<div class="top"><b>Harbor</b><span class="spacer"></span><a href="/">Portal</a></div>
<main style="max-width:22rem">
  <h1>Sign in</h1>
  <% if (error) { %><div class="err"><%= error %></div><% } %>
  <form method="post" action="/login">
    <p><label class="muted">Email</label><input type="email" name="email" autocomplete="username" required></p>
    <p><label class="muted">Password</label><input type="password" name="password" autocomplete="current-password" required></p>
    <button type="submit">Sign in</button>
  </form>
</main>
<script src="<%= assetOrigin %>/portal.js"></script>
</body></html>
