<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>
  :root { --line:#dbe0e6; --muted:#5f6b78; --ink:#101820; --accent:#1b4d8f; }
  * { box-sizing:border-box; }
  body { font:15px/1.55 -apple-system,"Segoe UI",Roboto,sans-serif; margin:0; color:var(--ink); background:#eef1f5; }
  a { color:var(--accent); }
  .top { background:#101820; color:#dbe4ee; padding:.85rem 1.5rem; display:flex; gap:1.2rem; align-items:center; }
  .top b { letter-spacing:.05em; font-size:.95rem; }
  .top .spacer { margin-left:auto; }
  .top a { color:#8fb8e8; text-decoration:none; font-size:.88rem; }
  main { max-width:54rem; margin:2rem auto; padding:0 1.5rem; }
  h1 { font-size:1.3rem; margin:0 0 1rem; }
  h2 { font-size:1rem; margin:1.5rem 0 .6rem; }
  .panel { background:#fff; border:1px solid var(--line); border-radius:5px; padding:1rem 1.2rem; margin-bottom:1rem; }
  .balance { font:600 2rem/1.1 ui-monospace,Menlo,monospace; letter-spacing:-.02em; }
  .muted { color:var(--muted); font-size:.87rem; }
  table { width:100%; border-collapse:collapse; font-size:.88rem; }
  th, td { text-align:left; padding:.45rem .4rem; border-bottom:1px solid var(--line); }
  th { color:var(--muted); font-size:.76rem; text-transform:uppercase; letter-spacing:.05em; }
  input, select { font:inherit; width:100%; padding:.5rem .65rem; border:1px solid #c2cad4; border-radius:4px; }
  button { font:inherit; padding:.5rem 1rem; border:0; border-radius:4px; background:var(--accent); color:#fff; cursor:pointer; }
  button.ghost { background:#fff; color:var(--accent); border:1px solid #c2cad4; }
  .err { background:#fff1f0; border:1px solid #ffccc7; color:#a8071a; padding:.5rem .7rem; border-radius:4px; margin-bottom:.9rem; font-size:.9rem; }
  code { background:#eef1f4; padding:.1rem .3rem; border-radius:3px; font-size:.85em; }
  .state { font-size:.74rem; text-transform:uppercase; letter-spacing:.05em; padding:.1rem .45rem; border-radius:999px; }
  .booked { background:#e6f0fb; color:#1b4d8f; }
  .cancelled { background:#f3f4f6; color:#6b7280; }
  .dispatched { background:#e8f6ec; color:#1e7135; }
</style>
