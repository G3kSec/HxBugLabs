<!doctype html>
<html lang="en"><head><%- include("partials/head") %><title>Sign in — Corvus Freightpay</title></head>
<body>
<div class="top"><b>CORVUS FREIGHTPAY</b></div>
<main style="max-width:22rem">
  <h1>Sign in</h1>
  <% if (error) { %><div class="err"><%= error %></div><% } %>
  <form method="post" action="/login">
    <p><label class="muted">Account email</label><input type="email" name="email" required></p>
    <p><label class="muted">Password</label><input type="password" name="password" required></p>
    <button type="submit">Sign in</button>
  </form>
</main>
</body></html>
