<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>
  :root { --line:#dfe3e8; --muted:#68727d; --ink:#16202b; --accent:#0f766e; }
  * { box-sizing:border-box; }
  body { font:15px/1.55 "Segoe UI", -apple-system, Roboto, sans-serif; margin:0; color:var(--ink); background:#f4f6f8; }
  a { color:var(--accent); }
  .top { background:#0f2027; color:#e8eef2; padding:.85rem 1.5rem; display:flex; gap:1.25rem; align-items:center; }
  .top b { letter-spacing:.06em; font-size:.95rem; }
  .top a { color:#9fd8d1; text-decoration:none; font-size:.88rem; }
  .top .spacer { margin-left:auto; }
  main { max-width:52rem; margin:2rem auto; padding:0 1.5rem; }
  h1 { font-size:1.3rem; margin:0 0 1rem; }
  .panel { background:#fff; border:1px solid var(--line); border-radius:6px; padding:1.1rem 1.3rem; margin-bottom:1rem; }
  .muted { color:var(--muted); font-size:.87rem; }
  table { width:100%; border-collapse:collapse; font-size:.9rem; }
  th, td { text-align:left; padding:.5rem .4rem; border-bottom:1px solid var(--line); }
  th { color:var(--muted); font-weight:600; font-size:.78rem; text-transform:uppercase; letter-spacing:.04em; }
  input { font:inherit; width:100%; padding:.55rem .7rem; border:1px solid #c3cad2; border-radius:4px; }
  button { font:inherit; padding:.55rem 1rem; border:0; border-radius:4px; background:var(--accent); color:#fff; cursor:pointer; }
  button.link { background:none; color:var(--accent); padding:0; text-decoration:underline; }
  .err { background:#fff1f0; border:1px solid #ffccc7; color:#a8071a; padding:.55rem .7rem; border-radius:4px; margin-bottom:.9rem; font-size:.9rem; }
  code { background:#eef1f4; padding:.1rem .3rem; border-radius:3px; }
</style>
