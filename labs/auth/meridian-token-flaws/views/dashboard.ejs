<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
  <header>
    <span class="brand">Meridian</span>
    <nav><a href="/logout">Log out</a></nav>
  </header>
  <main>
    <div class="card">
      <h1><%= user.displayName %></h1>
      <p class="muted">Account balance</p>
      <p class="balance">$<%= user.balance.toLocaleString('en-US', {minimumFractionDigits: 2}) %></p>
      <% if (user.notes) { %>
        <div class="notes"><%= user.notes %></div>
      <% } %>
    </div>
  </main>
</body>
</html>
