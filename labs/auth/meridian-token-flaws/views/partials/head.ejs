<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Meridian</title>
<style>
  * { box-sizing: border-box; }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #f4f6fb; color: #131a2b; margin: 0; }
  header { background: #101a33; color: #fff; padding: 0.9rem 1.5rem; display: flex; align-items: center; justify-content: space-between; }
  header .brand { font-weight: 700; }
  header nav a { color: #a9b6d9; text-decoration: none; margin-left: 1.1rem; font-size: 0.9rem; }
  header nav a:hover { color: #fff; }
  main { max-width: 640px; margin: 2rem auto; padding: 0 1.5rem; }
  .card { background: #fff; border: 1px solid #dfe4f2; border-radius: 8px; padding: 1.5rem; margin-bottom: 1rem; }
  h1 { font-size: 1.35rem; margin: 0 0 0.5rem; }
  label { display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem; }
  input { width: 100%; padding: 0.55rem 0.7rem; border: 1px solid #cdd6ee; border-radius: 6px; font-size: 0.9rem; margin-bottom: 1rem; font-family: inherit; }
  .btn { display: inline-block; background: #1d4ed8; color: #fff; border: none; padding: 0.55rem 1.1rem; border-radius: 6px; font-size: 0.88rem; font-weight: 600; text-decoration: none; cursor: pointer; }
  .btn:hover { background: #1739a8; }
  .error { background: #fdeaea; color: #a4222c; padding: 0.7rem 1rem; border-radius: 6px; margin-bottom: 1rem; font-size: 0.88rem; }
  .success { background: #e7f8ee; color: #17803c; padding: 0.7rem 1rem; border-radius: 6px; margin-bottom: 1rem; font-size: 0.88rem; }
  .muted { color: #5c6684; font-size: 0.85rem; }
  .balance { font-size: 1.6rem; font-weight: 700; margin: 0.4rem 0; }
  .notes { background: #f8f9fd; padding: 0.8rem 1rem; border-radius: 6px; font-size: 0.9rem; margin-top: 0.6rem; }
  .flag { font-family: ui-monospace, monospace; background: #131a2b; color: #7ecbff; padding: 0.6rem 0.9rem; border-radius: 6px; display: inline-block; margin-top: 0.5rem; }
  code.tok { font-family: ui-monospace, monospace; font-size: 0.85rem; background: #f2f4fb; padding: 0.5rem; border-radius: 4px; display: block; word-break: break-all; }
</style>
